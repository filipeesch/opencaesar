{
  "name": "roman-city-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Caesar III-inspired 2D isometric Roman city-builder that runs in the browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit tests/integration tests/determinism tests/golden tests/property",
    "test:e2e": "playwright test",
    "test:golden:update": "GOLDEN_UPDATE=1 vitest run tests/golden",
    "test:watch": "vitest"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
